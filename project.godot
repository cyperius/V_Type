; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="V_Type"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/graphic_elements/icon.svg"

[audio]

buses/default_bus_layout="res://ressources/default_bus_layout.tres"

[autoload]

AudioManager="*res://scenes/AudioManager.tscn"
Global="*res://scripts/Global.gd"
GameManager="*res://scripts/GameManager.gd"
Players="*res://Autoloads&GameManaging/Players.gd"

[display]

window/size/viewport_width=3860
window/size/viewport_height=2160
window/stretch/mode="viewport"

[importer_defaults]

wav={
"compress/mode": 0,
"edit/loop_begin": 0,
"edit/loop_end": -1,
"edit/loop_mode": 2,
"edit/normalize": true,
"edit/trim": false,
"force/8_bit": false,
"force/max_rate": true,
"force/max_rate_hz": 44100,
"force/mono": false
}

