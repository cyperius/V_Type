; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="V_Type"
run/main_scene="res://game_world/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/graphic_elements/icon.svg"

[audio]

buses/default_bus_layout="uid://dlhcts2nxnerk"

[autoload]

AudioManager="*res://Autoloads&GameManaging/AudioManager.tscn"
Global="*res://Autoloads&GameManaging/Global.gd"
GameManager="*res://Autoloads&GameManaging/GameManager.gd"
Players="*res://Autoloads&GameManaging/Players.gd"
CameraUtilities="*res://scripts/camera_utils.gd"
RumbleManager="*res://Autoloads&GameManaging/RumbleManager.gd"

[display]

window/size/viewport_width=3840
window/size/viewport_height=2160
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

wav={
"compress/mode": 0,
"edit/loop_begin": 0,
"edit/loop_end": -1,
"edit/loop_mode": 2,
"edit/normalize": true,
"edit/trim": false,
"force/8_bit": false,
"force/max_rate": true,
"force/max_rate_hz": 44100,
"force/mono": false
}

